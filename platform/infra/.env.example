# 이 파일을 같은 폴더의 .env 로 복사해 값을 채운다. .env 는 커밋 금지(.gitignore).
# 시크릿은 .env 로만 — compose 에 비밀번호 기본값 폴백을 추가하지 말 것 (→ platform/CLAUDE.md).

# --- warehouse (dbt 변환 연산 자원 전용 Postgres, 호스트 포트 5433) ---
PCS_WH_ADMIN_USER=pcs_admin
PCS_WH_ADMIN_PASSWORD=
PCS_WH_DB=pcs_wh

# dbt·extract 파이프라인 롤 (init 스크립트가 생성 — lnd~gold·wrk 쓰기)
PCS_DBT_USER=dbt_exec
PCS_DBT_PASSWORD=

# 분석가 롤 (wrk 쓰기, slv·gold 읽기 + statement_timeout → design/02)
PCS_ANALYST_USER=analyst
PCS_ANALYST_PASSWORD=

# --- extract 소스 (로컬 검증 = warehouse 내 src 목스키마 → dbt 롤 재사용 / 원격 = 실 EES 접속) ---
PCS_SRC_HOST=warehouse
PCS_SRC_PORT=5432
PCS_SRC_DB=pcs_wh
PCS_SRC_USER=dbt_exec
PCS_SRC_PASSWORD=

# === 사내 빌드 환경 (집/일반망은 전부 비워두면 no-op) ===
# 이미지 빌드 시점에만 적용(compose build.args). 런타임 컨테이너엔 주입되지 않음.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,postgresql,warehouse,openmetadata-server,ingestion
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=
