# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋 금지(.gitignore).
# docker compose 가 변수치환(${VAR})으로 읽는다.

# --- 소스 Oracle (외부 사내 DB 서버 — 필수) ---
# 로컬 Oracle 컨테이너는 없다. 반드시 외부 실서버 호스트를 지정한다.
PCS_ORACLE_HOST=
PCS_ORACLE_PORT=1521
PCS_ORACLE_SERVICE=FREEPDB1
PCS_ETL_PASSWORD=pcs_etl_pw          # PCS_ETL (Airflow OracleHook 커넥션)

# --- 웨어하우스 Postgres (외부 사내 DB 서버 — LND~GOLD·CTL, design/09) ---
PCS_WH_HOST=
PCS_WH_PORT=5432
PCS_WH_DB=
PCS_WH_USER=
PCS_WH_PASSWORD=

# --- dbt(Cosmos) 자격증명: profiles.yml env_var() 가 참조 ---
PCS_DBT_USER=DBT_EXEC
PCS_DBT_PASSWORD=dbt_exec_pw

# --- OpenMetadata 인제스트 (infra/openmetadata/*_ingest.yaml) ---
# OM UI 에서 발급한 JWT. 절대 레포에 커밋하지 말 것.
OPENMETADATA_JWT=

# --- (실타깃 Oracle Thick 모드용, 폐쇄망 배포 시) ---
# ORA_PYTHON_DRIVER_TYPE=thick
# ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient

# === 사내 빌드 환경 (집 환경은 전부 비워두면 no-op) ===
# 이미지 빌드 시점에만 적용(compose build.args). 런타임 컨테이너엔 주입되지 않음.

# --- 사내 프록시 ---
HTTP_PROXY=
HTTPS_PROXY=
# 내부 서비스는 프록시 우회: compose 서비스명 + 로컬 (+ 외부 DB 서버 호스트 PCS_ORACLE_HOST/PCS_WH_HOST 를 추가)
NO_PROXY=localhost,127.0.0.1,postgres

# --- 사내 pip 미러 (Nexus/Artifactory) ---
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=

# --- 사설 CA: certs/ 에 *.crt(PEM) 배치하면 빌드가 트러스트스토어에 등록. 실파일은 gitignore ---
